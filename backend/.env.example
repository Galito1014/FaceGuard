# FaceGuard AI — configuración para ejecución manual (Windows 10/11 o Raspberry Pi sin systemd)
# Copie este archivo como backend/.env y ajústelo. Se carga automáticamente al iniciar.
# Las variables ya definidas en el entorno (o en /etc/faceguard/faceguard.env del servicio
# systemd de la Raspberry Pi) tienen prioridad sobre este archivo.
# Las rutas admiten ~ y variables: %LOCALAPPDATA%\FaceGuard (Windows) o ~/faceguard-data (Linux).

# Red: 127.0.0.1 = solo este equipo · 0.0.0.0 = accesible desde la red local
FACEGUARD_HOST=127.0.0.1
FACEGUARD_PORT=8000

# Contraseña temporal del usuario "admin" en el PRIMER arranque (mín. 10 caracteres,
# con letras y números). Si se omite, se genera una y se guarda en <datos>/secret/initial_admin.txt
FACEGUARD_ADMIN_PASSWORD=CambiarEsto123

# Carpetas (por defecto backend/data y backend/models)
#FACEGUARD_DATA_DIR=backend/data
#FACEGUARD_MODELS_DIR=backend/models

FACEGUARD_CAMERA_NAME=CAM-01 Entrada principal

# Backend de captura de OpenCV: auto | dshow | msmf | v4l2 | any
#   auto en Windows prueba DirectShow y luego Media Foundation; en Raspberry Pi usa V4L2.
FACEGUARD_CAMERA_BACKEND=auto
# Índice máximo que se prueba al buscar cámaras en Windows (0..N)
#FACEGUARD_CAMERA_PROBE_MAX=5
# Video o URL RTSP en lugar de la cámara (pruebas):
#FACEGUARD_CAMERA_SOURCE=C:\videos\prueba.mp4

FACEGUARD_SESSION_HOURS=8
FACEGUARD_SECURE_COOKIES=0
