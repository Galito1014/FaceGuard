# /etc/faceguard/faceguard.env — configuración del servicio
FACEGUARD_HOST=0.0.0.0
FACEGUARD_PORT=8000
FACEGUARD_DATA_DIR=/var/lib/faceguard
FACEGUARD_MODELS_DIR=/opt/faceguard-ai/backend/models
FACEGUARD_FRONTEND_DIST=/opt/faceguard-ai/frontend/dist
FACEGUARD_CAMERA_NAME=CAM-01 Entrada principal
FACEGUARD_SESSION_HOURS=8
# Ponga "1" si sirve la aplicación por HTTPS (proxy inverso con certificado).
FACEGUARD_SECURE_COOKIES=0
# Contraseña temporal del usuario "admin" en el primer arranque (si se omite, se genera una
# aleatoria y se guarda en /var/lib/faceguard/secret/initial_admin.txt).
#FACEGUARD_ADMIN_PASSWORD=
