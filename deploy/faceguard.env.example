# /etc/faceguard/faceguard.env — configuración del servicio en la Raspberry Pi
FACEGUARD_EDITION=pi
FACEGUARD_HOST=0.0.0.0
FACEGUARD_PORT=8000
# Redes que pueden abrir el panel: "local" = este equipo + redes privadas (LAN).
# Aunque el servicio escuche en 0.0.0.0, una conexión desde Internet recibe 403.
# No abra el puerto en el router; para acceso remoto use una VPN.
FACEGUARD_ALLOWED_NETWORKS=local
FACEGUARD_DATA_DIR=/var/lib/faceguard
FACEGUARD_MODELS_DIR=/opt/faceguard-ai/backend/models
FACEGUARD_FRONTEND_DIST=/opt/faceguard-ai/frontend/dist
FACEGUARD_CAMERA_NAME=CAM-01 Entrada principal
# Cámara: auto (USB por V4L2) o picamera2 (cámara CSI; el instalador lo pone con --csi)
FACEGUARD_CAMERA_BACKEND=auto
FACEGUARD_SESSION_HOURS=8
# Ponga "1" si sirve la aplicación por HTTPS (proxy inverso con certificado).
FACEGUARD_SECURE_COOKIES=0
# Sin contraseña inicial, el panel muestra el asistente de configuración, que pide
# el código de /var/lib/faceguard/secret/setup_code.txt. Solo para instalaciones
# automatizadas: definir aquí la contraseña temporal del usuario "admin".
#FACEGUARD_ADMIN_PASSWORD=
